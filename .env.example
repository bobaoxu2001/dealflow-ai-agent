# Copy to .env and adjust. All values have safe local defaults.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
# Local default is SQLite (zero infra). For Docker/Postgres use the URL below:
# DATABASE_URL=postgresql+psycopg2://dealflow:dealflow@db:5432/dealflow
DATABASE_URL=sqlite:///./dealflow.db

# --- Embeddings ---
# local  -> deterministic, no API key (default)
# openai -> requires OPENAI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM final-report synthesis (optional) ---
# Agent logic/routing is always deterministic; the LLM only writes the narrative
# summary and can NEVER trigger a CRM writeback or bypass human approval.
# local  -> deterministic template summary, no API key (default)
# openai -> real LLM if OPENAI_API_KEY is set (falls back to local otherwise)
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Agent thresholds ---
HIGH_RISK_THRESHOLD=0.6
APPROVAL_REQUIRED_FIELDS=stage,deal_value,close_date

# --- CRM adapter (external integration is OFF by default) ---
# local         -> the project's own database (default; no secrets)
# mock_external -> simulated external CRM (no network)
# hubspot       -> real HubSpot CRM v3 API (opt-in; dry-run by default)
CRM_ADAPTER=local
# Required only when CRM_ADAPTER=hubspot. Never commit a real token.
# HUBSPOT_ACCESS_TOKEN=pat-na1-...
HUBSPOT_BASE_URL=https://api.hubapi.com
# Safety: real PATCH writeback is sent only when this is false.
HUBSPOT_DRY_RUN=true
HUBSPOT_TIMEOUT_SECONDS=10
